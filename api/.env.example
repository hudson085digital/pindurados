# Ambiente
NODE_ENV=dev
PORT=3333

# Chave para assinar os tokens de login (troque por um valor secreto)
JWT_SECRET=pindurados-segredo-troque-isto

# Banco de dados PostgreSQL (Docker local).
# No futuro, troque pela connection string do Supabase.
DATABASE_URL="postgresql://postgres:docker@localhost:5432/pindurados?schema=public"
