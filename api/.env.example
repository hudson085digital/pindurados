# Ambiente
NODE_ENV=dev
PORT=3333

# Chave para assinar os tokens de login (troque por um valor secreto)
JWT_SECRET=pindurados-segredo-troque-isto

# --- Banco de dados PostgreSQL ---
# Local (Docker): use a mesma URL nas duas variáveis.
DATABASE_URL="postgresql://postgres:docker@localhost:5432/pindurados?schema=public"
DIRECT_URL="postgresql://postgres:docker@localhost:5432/pindurados?schema=public"

# Produção (Supabase): Project Settings > Database > Connection string.
#   DATABASE_URL = conexão pooled (porta 6543) + ?pgbouncer=true
#   DIRECT_URL   = conexão direta (porta 5432) — usada só nas migrations
# DATABASE_URL="postgresql://postgres.xxxx:SENHA@aws-0-...pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xxxx:SENHA@aws-0-...pooler.supabase.com:5432/postgres"
